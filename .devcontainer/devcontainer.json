{
  "name": "Nanobot Conversation Dev",
  "dockerComposeFile": "../docker-compose.dev.yml",
  "service": "dev",
  "workspaceFolder": "/workspaces/nanobot-homeassistant",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "runServices": ["dev", "homeassistant"],
  "shutdownAction": "stopCompose",
  "overrideCommand": false,
  "forwardPorts": [18123],
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "redhat.vscode-yaml"]
    }
  }
}
